  <PropertyGroup>
    <RootNamespace>FastTowerDefenceRelay</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The relay runs in a generic host and maps the HTTP room listing. -->
